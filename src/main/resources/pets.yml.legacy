    health: 100
    speed: 10
    revival: true
    cooldown: 30
    features:
      - "CHEST: FALSE"
      - "ARMOR: IRON_BARDING"
      - "COLOR: DARK_BROWN"
      - "STYLE: WHITE"
  pig:
    name: "&6&l小猪"
    item-name: "&5&l小猪召唤石"
    lore:
      - "&e&o奔跑起来，比风还快！"
      - "&e&o不过……我的胡萝卜呢？"
    item: MONSTER_EGG:Pig
    type: MOUNT
    health: 100
    speed: 12.5
    revival: true
    cooldown: 60
    skin: PIG
