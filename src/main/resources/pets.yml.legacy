    type: COMPANION
    health: 30
    damage: 5
    speed: 4
    attack-mobs: false
    attack-players: true
    revival: true
    cooldown: 45
    features:
      - "COLLAR: BLUE"
  legendary-wolf:
    name: "&5&l苍狼王"
    item-name: "&5&l苍狼王召唤石"
    lore:
      - "&e&o只有少数勇者能成为传说……"
    item: MONSTER_EGG:Silverfish
    type: COMPANION
    level: 10
