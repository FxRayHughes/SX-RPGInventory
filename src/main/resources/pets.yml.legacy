# 宠物与食物示例；名称和描述可修改，物品类型、特征枚举和职业 ID 须保持插件要求的格式。
# classes 中的 Mage、Warrior 是职业插件的示例 ID，请按实际职业配置替换。
pets:
  kitty:
    name: "&7&l小猫"
    item-name: "&7&l小猫召唤石"
    lore:
      - "&e&o喵！喵！喵！"
    item: MONSTER_EGG:Ghast
    type: COMPANION
    health: 20
    damage: 3
    speed: 3.5
    attack-mobs: false
    attack-players: false
    revival: true
    cooldown: 60
    skin: OCELOT
    features:
      - "BABY: TRUE"
      - "TYPE: BLACK_CAT"
  puppy:
    name: "&7&l小狗"
    item-name: "&7&l小狗召唤石"
    lore:
      - "&e&o汪！汪！汪！"
    item: MONSTER_EGG:Ghast
    type: COMPANION
    health: 20
    damage: 3
    speed: 3.5
    attack-mobs: true
    attack-players: false
    revival: true
    cooldown: 60
    features:
      - "BABY: TRUE"
      - "COLLAR: BLACK"
  rare-wolf:
    name: "&9&l野狼"
    item-name: "&9&l野狼召唤石"
    lore:
      - "&e&o忠诚的伙伴，经得起冒险的考验"
